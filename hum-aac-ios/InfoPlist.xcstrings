    "NSCameraUsageDescription" : {
      "comment" : "Shown when Hum asks to use the camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Take a photo of the real thing for a tile. Photos stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una foto de la cosa real para una casilla. Las fotos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez en photo l'objet réel pour une case. Les photos restent sur cet appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ein Foto vom echten Gegenstand für ein Feld. Fotos bleiben auf diesem Gerät."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto da coisa real para um cartão. As fotos ficam neste dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta una foto dell'oggetto reale per una casella. Le foto restano su questo dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为卡片拍一张实物照片。照片只保存在这台设备上。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown when Hum asks to use the local network (Share & sync → Send / Receive with a nearby device).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Send boards straight between your iPad, iPhone and Mac when they're near each other, only when you choose to. Nothing goes through the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tableros directamente entre tu iPad, iPhone y Mac cuando están cerca, solo cuando tú lo decidas. Nada pasa por internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des tableaux directement entre votre iPad, iPhone et Mac quand ils sont proches, seulement quand vous le décidez. Rien ne passe par Internet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende Tafeln direkt zwischen deinem iPad, iPhone und Mac, wenn sie nah beieinander sind, nur wenn du es möchtest. Nichts geht über das Internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie pranchas direto entre seu iPad, iPhone e Mac quando estiverem perto, só quando você quiser. Nada passa pela internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia le tabelle direttamente tra iPad, iPhone e Mac quando sono vicini, solo quando lo scegli tu. Niente passa da internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你选择时，把沟通板直接发送到附近你的 iPad、iPhone 和 Mac 之间。不经过互联网。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Shown when Hum asks to use the microphone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a tile's phrase in your own voice. Recordings stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba la frase de una casilla con tu propia voz. Las grabaciones se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la phrase d'une case avec votre propre voix. Les enregistrements restent sur cet appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm den Satz eines Feldes mit deiner eigenen Stimme auf. Aufnahmen bleiben auf diesem Gerät."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave a frase de um cartão com a sua própria voz. As gravações ficam neste dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la frase di una casella con la tua voce. Le registrazioni restano su questo dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你自己的声音录下卡片的短语。录音只保存在这台设备上。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
