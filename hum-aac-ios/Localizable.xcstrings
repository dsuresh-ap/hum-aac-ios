    "The helper couldn't make suggestions for that. Try describing what your child says or loves in a different way." : {
      "comment" : "Error message when the AI helper can't generate suggestions for the given prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente no pudo hacer sugerencias para eso. Prueba a describir de otra forma lo que dice o le encanta a tu hijo o hija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant n'a pas pu faire de suggestions pour cela. Essayez de décrire autrement ce que votre enfant dit ou aime."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent konnte dafür keine Vorschläge machen. Beschreib anders, was dein Kind sagt oder liebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente não conseguiu fazer sugestões para isso. Tente descrever de outro jeito o que sua criança diz ou adora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistente non è riuscito a dare suggerimenti per questo. Prova a descrivere in un altro modo cosa dice o cosa ama tuo figlio o tua figlia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
