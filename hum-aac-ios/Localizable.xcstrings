    "This device only has the basic voices, which can sound robotic. Apple's natural voices are free; download one once and Hum switches to it automatically." : {
      "comment" : "A description of the limitations of the default voices on the device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo solo tiene las voces básicas, que pueden sonar robóticas. Las voces naturales de Apple son gratuitas: descarga una una vez y Hum la usará automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a que les voix de base, qui peuvent sembler robotiques. Les voix naturelles d'Apple sont gratuites : téléchargez-en une une fois et Hum l'utilisera automatiquement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat nur die einfachen Stimmen, die roboterhaft klingen können. Die natürlichen Stimmen von Apple sind kostenlos: Lade einmal eine, dann wechselt Hum automatisch zu ihr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo só tem as vozes básicas, que podem soar robóticas. As vozes naturais da Apple são gratuitas: baixe uma uma vez e o Hum passa a usá-la automaticamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha solo le voci di base, che possono sembrare robotiche. Le voci naturali di Apple sono gratuite: scaricane una una volta e Hum la userà automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备只有基础语音，听起来可能像机器人。Apple 的自然语音是免费的：下载一次后，Hum 会自动切换到它。"
          }
        }
      }
    },
