    "Hum couldn't reach nearby devices. Check that Wi-Fi is on, and that Hum is allowed to use the local network in Settings." : {
      "comment" : "An error when nearby sending can't start.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum no pudo encontrar dispositivos cercanos. Comprueba que la wifi está activada y que Hum puede usar la red local en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum n'a pas pu joindre les appareils à proximité. Vérifiez que le Wi-Fi est activé et que Hum peut utiliser le réseau local dans Réglages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum konnte keine Geräte in der Nähe erreichen. Prüfe, ob WLAN an ist und ob Hum in den Einstellungen das lokale Netzwerk verwenden darf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hum não conseguiu alcançar dispositivos próximos. Confira se o Wi-Fi está ligado e se o Hum pode usar a rede local nos Ajustes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum non riesce a raggiungere i dispositivi vicini. Controlla che il Wi-Fi sia attivo e che Hum possa usare la rete locale in Impostazioni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum 无法连接附近的设备。请确认无线局域网已打开，并在“设置”中允许 Hum 使用本地网络。"
          }
        }
      }
    },
    "Hum doesn't understand how this file is laid out." : {
      "comment" : "A problem found in a Hum file. The first value is the board or tile it is about (like Tile “snack”). Words in “ ” such as “spokenText” are names from the file: keep them as they are.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum no entiende cómo está organizado este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum ne comprend pas comment ce fichier est organisé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum versteht nicht, wie diese Datei aufgebaut ist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hum não entende como este arquivo está organizado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum non capisce come è organizzato questo file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum 无法理解这个文件的结构。"
          }
        }
      }
    },
    "Hum file" : {
      "comment" : "Label for the file picker parameter in the Import Hum Boards shortcut.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
