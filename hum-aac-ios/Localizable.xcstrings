    "Tell the helper about your child, or paste phrases they say. It suggests whole-phrase tiles, and you choose which ones to add." : {
      "comment" : "A description of the helper's purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale al asistente sobre tu hijo o hija, o pega frases que dice. Sugiere casillas de frases completas, y tú eliges cuáles añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez de votre enfant à l'assistant, ou collez des phrases qu'il ou elle dit. Il suggère des cases avec des phrases entières, et vous choisissez celles à ajouter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzähl dem Assistenten von deinem Kind oder füge Sätze ein, die es sagt. Er schlägt Felder mit ganzen Sätzen vor, und du wählst aus, welche hinzukommen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte ao assistente sobre sua criança, ou cole frases que ela diz. Ele sugere cartões com frases inteiras, e você escolhe quais adicionar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconta all'assistente di tuo figlio o tua figlia, o incolla frasi che dice. Suggerisce caselle con frasi intere, e tu scegli quali aggiungere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向助手介绍孩子，或粘贴孩子常说的短语。它会建议完整短语的卡片，由你选择添加哪些。"
          }
        }
      }
    },
