          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie von Hum kann iCloud nicht nutzen (Fehler %lld). Deine Tafeln sind auf diesem Gerät sicher."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
