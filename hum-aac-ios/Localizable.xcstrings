    "New tiles go in empty spots. Nothing already on your boards moves. You can undo." : {
      "comment" : "A description of the functionality of the \"Add\" button in the \"Help me set up\" view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las casillas nuevas van en lugares vacíos. Nada de lo que ya está en tus tableros se mueve. Puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles cases vont dans les places vides. Rien de ce qui est déjà dans vos tableaux ne bouge. Vous pouvez annuler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Felder kommen an freie Stellen. Nichts, was schon auf deinen Tafeln ist, wird verschoben. Du kannst es widerrufen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões novos vão para lugares vazios. Nada que já está nas suas pranchas muda de lugar. Você pode desfazer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove caselle vanno nei posti vuoti. Niente di quello che è già nelle tue tabelle si sposta. Puoi annullare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新卡片会放在空位上。沟通板上已有的内容都不会移动。你可以撤销。"
          }
        }
      }
    },
