    "Describe what your child needs, or paste phrases they say, and get suggested tiles to preview. Off until you turn it on." : {
      "comment" : "A description of the AI helper.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe lo que necesita tu hijo o hija, o pega frases que dice, y recibe casillas sugeridas para revisar. Está desactivado hasta que lo actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez les besoins de votre enfant, ou collez des phrases qu'il ou elle dit, et recevez des suggestions de cases à vérifier. Désactivé tant que vous ne l'activez pas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe, was dein Kind braucht, oder füge Sätze ein, die es sagt, und erhalte Vorschläge für Felder zur Vorschau. Aus, bis du es einschaltest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o que sua criança precisa, ou cole frases que ela diz, e receba sugestões de cartões para conferir. Fica desligado até você ligar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi di cosa ha bisogno tuo figlio o tua figlia, o incolla frasi che dice, e ricevi caselle suggerite da controllare. È spento finché non lo attivi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述孩子的需要，或粘贴孩子常说的短语，获取建议的卡片并预览。在你打开之前一直是关闭的。"
          }
        }
      }
    },
