    "Private Cloud Compute couldn't be reached, and the helper on this device isn't available either. Check your internet connection and try again." : {
      "comment" : "Error message when the Private Cloud Compute service is unavailable and the device-only AI helper is also unavailable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Private Cloud Compute, y el asistente de este dispositivo tampoco está disponible. Revisa tu conexión a internet y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre Private Cloud Compute, et l'assistant sur cet appareil n'est pas disponible non plus. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Cloud Compute war nicht erreichbar, und der Assistent auf diesem Gerät ist auch nicht verfügbar. Prüfe deine Internetverbindung und versuch es noch einmal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o Private Cloud Compute, e o assistente neste dispositivo também não está disponível. Verifique sua conexão com a internet e tente de novo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere Private Cloud Compute, e nemmeno l'assistente su questo dispositivo è disponibile. Controlla la connessione a Internet e riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Private Cloud Compute，这台设备上的助手也不可用。请检查网络连接后重试。"
          }
        }
      }
    },
