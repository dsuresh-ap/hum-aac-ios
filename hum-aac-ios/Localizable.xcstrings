    "The other device sent something Hum can't read. Make sure both devices have the latest Hum, then try again." : {
      "comment" : "An error during a nearby transfer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo envió algo que Hum no puede leer. Asegúrate de que los dos dispositivos tienen la última versión de Hum e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autre appareil a envoyé quelque chose que Hum ne peut pas lire. Vérifiez que les deux appareils ont la dernière version de Hum, puis réessayez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät hat etwas gesendet, das Hum nicht lesen kann. Achte darauf, dass beide Geräte die neueste Version von Hum haben, und versuch es noch einmal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo enviou algo que o Hum não consegue ler. Confira se os dois dispositivos têm a versão mais recente do Hum e tente de novo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo ha inviato qualcosa che Hum non riesce a leggere. Assicurati che entrambi i dispositivi abbiano l'ultima versione di Hum, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备发送了 Hum 无法读取的内容。请确认两台设备都安装了最新版 Hum，然后再试一次。"
          }
        }
      }
    },
    "The other device stopped." : {
      "comment" : "The other device cancelled the transfer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
