    "Each line becomes one tile, kept whole. Don't need suggestions? Use Add → Paste phrases instead." : {
      "comment" : "A description of the second step of the AI helper.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada línea se convierte en una casilla, completa. ¿No necesitas sugerencias? Usa Añadir → Pegar frases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne devient une case, entière. Pas besoin de suggestions ? Utilisez Ajouter → Coller des phrases."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile wird ein Feld, als Ganzes. Keine Vorschläge nötig? Nimm Hinzufügen → Sätze einfügen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
