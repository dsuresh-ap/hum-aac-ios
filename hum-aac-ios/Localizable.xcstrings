    "“%@” is already on your boards." : {
      "comment" : "A note that says a phrase is already on the user's boards.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya está en tus tableros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà dans vos tableaux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist schon auf deinen Tafeln."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já está nas suas pranchas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è già nelle tue tabelle."
          }
