    "\"What is it for?\" only sets the color. A hidden tile keeps its spot as empty space, so nothing else moves." : {
      "comment" : "The text that appears under the toggle to hide a tile.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "Placeholder only (a tile's or board's own name). Keep it as it is."
    },
    "%@ (Home)" : {
      "comment" : "A board's name, marked as the Home board."
    },
    "%@ (error %lld)" : {
