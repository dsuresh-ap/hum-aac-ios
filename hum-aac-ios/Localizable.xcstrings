    "This copy of Hum can't use iCloud (error %lld). Your boards are safe on this device." : {
      "comment" : "A description of an error that might occur when syncing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de Hum no puede usar iCloud (error %lld). Tus tableros están a salvo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
