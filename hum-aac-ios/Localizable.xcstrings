          "stringUnit" : {
            "state" : "translated",
            "value" : "它的位置会空出来。其他卡片保持不动。你可以撤销。"
          }
        }
      }
    },
    "Its tiles are deleted too. Tiles that opened it will still speak. You can undo this." : {
      "comment" : "A message that appears when the user deletes a folder.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus casillas también se eliminan. Las casillas que la abrían seguirán hablando. Puedes deshacerlo."
          }
