    "%@ has a picture credit but no picture. The credit is kept anyway." : {
      "comment" : "A problem found in a Hum file. The first value is the board or tile it is about (like Tile “snack”). Words in “ ” such as “spokenText” are names from the file: keep them as they are.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene un crédito de imagen pero no tiene imagen. El crédito se conserva igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a un crédit d'image mais pas d'image. Le crédit est conservé quand même."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eine Bildquelle, aber kein Bild. Die Quellenangabe bleibt trotzdem erhalten."
