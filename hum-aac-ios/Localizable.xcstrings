    "%@ has the same ID as another board. Every board needs its own ID." : {
      "comment" : "A problem found in a Hum file. The first value is the board or tile it is about (like Tile “snack”). Words in “ ” such as “spokenText” are names from the file: keep them as they are.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene el mismo ID que otro tablero. Cada tablero necesita su propio ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a le même identifiant qu'un autre tableau. Chaque tableau a besoin de son propre identifiant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dieselbe ID wie eine andere Tafel. Jede Tafel braucht ihre eigene ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem o mesmo ID de outra prancha. Cada prancha precisa do seu próprio ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha lo stesso ID di un'altra tabella. Ogni tabella ha bisogno del suo ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 ID 与另一块沟通板相同。每块沟通板都需要自己的 ID。"
          }
        }
      }
    },
    "%@ has the same ID as another tile. Every tile needs its own ID." : {
      "comment" : "A problem found in a Hum file. The first value is the board or tile it is about (like Tile “snack”). Words in “ ” such as “spokenText” are names from the file: keep them as they are.",
      "localizations" : {
        "es" : {
