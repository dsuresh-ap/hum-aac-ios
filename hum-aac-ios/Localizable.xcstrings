    "Searching sends only your search word to %@. The symbol you pick is saved in the tile, so it works offline." : {
      "comment" : "A description of how the symbol search works. The argument is the name of the symbol library source.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al buscar solo se envía tu palabra de búsqueda a %@. El símbolo que elijas se guarda en la casilla, así que funciona sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche n'envoie que votre mot à %@. Le symbole choisi est enregistré dans la case, il fonctionne donc hors ligne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Suche wird nur dein Suchwort an %@ geschickt. Das Symbol, das du wählst, wird im Feld gespeichert und funktioniert so auch offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca envia só a palavra buscada para %@. O símbolo escolhido é salvo no cartão, então funciona sem internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca invia solo la parola cercata a %@. Il simbolo che scegli viene salvato nella casella, quindi funziona anche offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索时只会把你的搜索词发送给 %@。你选的符号会保存在卡片里，离线也能用。"
          }
        }
      }
    },
