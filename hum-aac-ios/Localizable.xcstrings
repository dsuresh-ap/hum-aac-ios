    "%@ A backup of your current boards is saved first, and you can undo." : {
      "comment" : "A description of the import process when the user opts to replace everything.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Primero se guarda una copia de seguridad de tus tableros, y puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Une sauvegarde de vos tableaux actuels est d'abord enregistrée, et vous pouvez annuler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vorher wird eine Sicherung deiner jetzigen Tafeln gespeichert, und du kannst es widerrufen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Antes, um backup das suas pranchas atuais é salvo, e você pode desfazer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Prima viene salvato un backup delle tue tabelle attuali, e puoi annullare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会先保存当前沟通板的备份，你也可以撤销。"
          }
        }
      }
    },
    "%@ and tile “%@” are in the same spot (row %lld, column %lld) on %@." : {
      "comment" : "A problem found in a Hum file. The first value is the board or tile it is about (like Tile “snack”). Words in “ ” such as “spokenText” are names from the file: keep them as they are.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and tile “%2$@” are in the same spot (row %3$lld, column %4$lld) on %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y la casilla «%2$@» están en el mismo lugar (fila %3$lld, columna %4$lld) en %5$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et la case « %2$@ » sont au même endroit (ligne %3$lld, colonne %4$lld) dans %5$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und Feld „%2$@“ liegen an derselben Stelle (Zeile %3$lld, Spalte %4$lld) auf %5$@."
