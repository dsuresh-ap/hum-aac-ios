      }
    },
    "“%@” sounds like praise or an instruction. Hum tiles are your child's own voice, so we suggest a phrase your child would say." : {
      "comment" : "A warning that a phrase might be interpreted as a command or praise, and suggests a different phrase.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» parece un elogio o una orden. Las casillas de Hum son la propia voz de tu hijo o hija, así que te sugerimos una frase que diría tu hijo o hija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ressemble à une félicitation ou à une consigne. Les cases de Hum sont la propre voix de votre enfant : nous vous suggérons plutôt une phrase que votre enfant dirait."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ klingt nach Lob oder einer Anweisung. Hum-Felder sind die eigene Stimme deines Kindes, deshalb schlagen wir einen Satz vor, den dein Kind sagen würde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” parece um elogio ou uma ordem. Os cartões do Hum são a própria voz da sua criança, então sugerimos uma frase que sua criança diria."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sembra una lode o un'istruzione. Le caselle di Hum sono la voce di tuo figlio o tua figlia, quindi ti suggeriamo una frase che direbbe lui o lei."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”听起来像表扬或指令。Hum 的卡片是孩子自己的声音，所以我们建议使用孩子会说的话。"
          }
        }
      }
    },
    "“%@” wants to send “%@” (%@)." : {
      "comment" : "On the receiving device: the sending device's name, the file name, and its size (like 2.1 MB).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” wants to send “%2$@” (%3$@)."
          }
