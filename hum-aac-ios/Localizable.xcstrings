            "value" : "L'autre appareil a arrêté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät hat abgebrochen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo parou."
          }
        },
        "it" : {
          "stringUnit" : {
