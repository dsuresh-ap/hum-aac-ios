    },
    "You've used today's Private Cloud Compute requests. They refresh %@. You can switch to “On this device” now." : {
      "comment" : "Date is a localized date, like \"this morning\" or \"next week\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya usaste las solicitudes de hoy a Private Cloud Compute. Se renuevan %@. Ahora puedes cambiar a «En este dispositivo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
