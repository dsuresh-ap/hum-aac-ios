    "Today's Private Cloud Compute requests are used up. They refresh %@. “On this device” still works." : {
      "comment" : "A message that says that today's Private Cloud Compute requests are used up, and that the next time it runs, it'll be after a certain date.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se usaron las solicitudes de hoy a Private Cloud Compute. Se renuevan %@. «En este dispositivo» sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes Private Cloud Compute du jour sont épuisées. Elles se renouvellent %@. « Sur cet appareil » fonctionne toujours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutigen Private Cloud Compute-Anfragen sind aufgebraucht. Sie werden %@ erneuert. „Auf diesem Gerät“ funktioniert weiterhin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As solicitações de hoje ao Private Cloud Compute acabaram. Elas renovam %@. “Neste dispositivo” continua funcionando."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste di oggi a Private Cloud Compute sono finite. Si rinnovano %@. «Su questo dispositivo» funziona ancora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的 Private Cloud Compute 请求已用完。将于%@恢复。“在这台设备上”仍可使用。"
          }
        }
      }
    },
