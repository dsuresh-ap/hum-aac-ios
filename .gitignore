# Hum .gitignore
# This is a public repo: never commit signing secrets, personal settings or build output.

# --- Xcode: per-user state ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
# Keep shared schemes and workspace checks (xcshareddata/) tracked.

# --- Xcode: build output ---
DerivedData/
build/
*.hmap
*.ipa
*.xcarchive
*.xcresult
*.dSYM
*.dSYM.zip
timeline.xctimeline
playground.xcworkspace
*.profraw

# --- Swift Package Manager ---
.build/
.swiftpm/
Package.resolved

# --- Code signing and secrets (never commit) ---
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
.env
.env.*
*.secret
*.pem
*.key

# --- CI / release tooling output ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# --- Editors and OS ---
.DS_Store
.AppleDouble
.LSOverride
Icon[]
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*~

# --- Local tool config ---
.mcp.json
.claude/settings.local.json

# --- Local test fixtures (real families' boards; never commit) ---
TestFixtures/Local/
